import 'dart:math' as math;
import 'package:flutter/material.dart';

void main() {
  runApp(const ToonSquidCloneApp());
}

class ToonSquidCloneApp extends StatelessWidget {
  const ToonSquidCloneApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'VectorFlow Studio Ultimate',
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark().copyWith(
        scaffoldBackgroundColor: const Color(0xFF1E1E1E),
        canvasColor: const Color(0xFF121212),
      ),
      home: const WorkspaceScreen(),
    );
  }
}

// ==================== Модели данных ====================

enum ToolType { brush, eraser, vectorNode, boneRotate }

class VectorNode {
  Offset position;
  VectorNode({required this.position});
}

class VectorPathShape {
  String id;
  List<VectorNode> nodes;
  Color color;
  double strokeWidth;

  VectorPathShape({
    required this.id,
    required this.nodes,
    required this.color,
    required this.strokeWidth,
  });
}

class Bone {
  String id;
  String name;
  String? parentId;
  double length;
  double rotation;
  Offset localPosition;

  Bone({
    required this.id,
    required this.name,
    this.parentId,
    required this.length,
    this.rotation = 0.0,
    this.localPosition = Offset.zero,
  });

  Bone clone() => Bone(
        id: id,
        name: name,
        parentId: parentId,
        length: length,
        rotation: rotation,
        localPosition: localPosition,
      );
}

class AnimLayer {
  String id;
  String name;
  bool isVisible;
  bool isLocked;
  List<VectorPathShape> vectorShapes; // Векторные кривые с узлами
  List<Bone> bones; // Скелет

  AnimLayer({
    required this.id,
    required this.name,
    this.isVisible = true,
    this.isLocked = false,
    List<VectorPathShape>? vectorShapes,
    List<Bone>? bones,
  })  : vectorShapes = vectorShapes ?? [],
        bones = bones ?? [
          Bone(id: 'root', name: 'Торс/Плечо', length: 120, localPosition: const Offset(250, 250)),
          Bone(id: 'elbow', name: 'Предплечье', parentId: 'root', length: 90, localPosition: const Offset(120, 0)),
        ];

  AnimLayer clone() => AnimLayer(
        id: id,
        name: name,
        isVisible: isVisible,
        isLocked: isLocked,
        vectorShapes: vectorShapes.map((s) => VectorPathShape(
          id: s.id,
          nodes: s.nodes.map((n) => VectorNode(position: n.position)).toList(),
          color: s.color,
          strokeWidth: s.strokeWidth,
        )).toList(),
        bones: bones.map((b) => b.clone()).toList(),
      );
}

// ==================== Главный экран редактора ====================

class WorkspaceScreen extends StatefulWidget {
  const WorkspaceScreen({super.key});

  @override
  State<WorkspaceScreen> createState() => _WorkspaceScreenState();
}

class _WorkspaceScreenState extends State<WorkspaceScreen> {
  int currentFrame = 1;
  final int totalFrames = 24;

  final Map<int, List<AnimLayer>> projectFrames = {};
  String activeLayerId = 'layer_1';
  
  ToolType currentTool = ToolType.vectorNode;
  Color currentColor = Colors.white;
  double strokeWidth = 5.0;
  
  String? selectedBoneId = 'root';
  int? selectedNodeIndex;
  VectorPathShape? activeVectorShape;

  @override
  void initState() {
    super.initState();
    _initFrames();
  }

  void _initFrames() {
    for (int i = 1; i <= totalFrames; i++) {
      projectFrames[i] = [AnimLayer(id: 'layer_1', name: 'Векторный Слой 1')];
    }
  }

  List<AnimLayer> get _currentLayers => projectFrames[currentFrame] ?? [];

  AnimLayer get _activeLayer {
    try {
      return _currentLayers.firstWhere((l) => l.id == activeLayerId);
    } catch (_) {
      return _currentLayers.first;
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('VectorFlow Studio Pro (ToonSquid Core)'),
        backgroundColor: const Color(0xFF2C2C2C),
        actions: [
          IconButton(
            icon: const Icon(Icons.download, color: Colors.greenAccent),
            tooltip: 'Экспорт проекта / Видео',
            onPressed: () {
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(content: Text('Рендеринг последовательности кадров... Готово!')),
              );
            },
          ),
        ],
      ),
      body: Row(
        children: [
          // Панель инструментов и рига
          SizedBox(
            width: 270,
            child: Container(
              color: const Color(0xFF222222),
              padding: const EdgeInsets.all(10),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('Инструменты:', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.grey)),
                  const SizedBox(height: 6),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceAround,
                    children: [
                      _toolButton(ToolType.vectorNode, Icons.polyline, 'Вектор'),
                      _toolButton(ToolType.boneRotate, Icons.accessibility, 'Кости'),
                    ],
                  ),
                  const Divider(color: Colors.white24, height: 20),
                  if (currentTool == ToolType.vectorNode) ...[
                    const Text('Векторные узлы:', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.blueAccent)),
                    const SizedBox(height: 8),
                    ElevatedButton.icon(
                      style: ElevatedButton.styleFrom(backgroundColor: Colors.blueAccent),
                      onPressed: () {
                        setState(() {
                          final newShape = VectorPathShape(
                            id: 'shape_${DateTime.now().millisecondsSinceEpoch}',
                            nodes: [
                              VectorNode(position: const Offset(150, 200)),
                              VectorNode(position: const Offset(250, 150)),
                              VectorNode(position: const Offset(350, 250)),
                            ],
                            color: currentColor,
                            strokeWidth: strokeWidth,
                          );
                          _activeLayer.vectorShapes.add(newShape);
                          activeVectorShape = newShape;
                        });
                      },
                      icon: const Icon(Icons.add),
                      label: const Text('Создать кривую'),
                    ),
                  ] else ...[
                    const Text('Костная система:', style: TextStyle(fontWeight: FontWeight.bold, color: Colors.orangeAccent)),
                    Expanded(
                      child: ListView(
                        children: _activeLayer.bones.map((bone) {
                          bool isSelected = bone.id == selectedBoneId;
                          return ListTile(
                            dense: true,
                            selected: isSelected,
                            selectedTileColor: Colors.orange.withOpacity(0.3),
                            title: Text(bone.name),
                            subtitle: Text('Угол: ${(bone.rotation * 180 / math.pi).toStringAsFixed(1)}°'),
                            onTap: () => setState(() => selectedBoneId = bone.id),
                          );
                        }).toList(),
                      ),
                    ),
                  ],
                ],
              ),
            ),
          ),
          const VerticalDivider(width: 1, color: Colors.black),

          // Холст для редактирования кривых и костей
          Expanded(
            child: Container(
              color: const Color(0xFF141414),
              child: GestureDetector(
                onPanUpdate: (details) {
                  setState(() {
                    if (currentTool == ToolType.boneRotate) {
                      final bone = _activeLayer.bones.firstWhere((b) => b.id == selectedBoneId, orElse: () => _activeLayer.bones.first);
                      bone.rotation += details.delta.dx * 0.02;
                    } else if (currentTool == ToolType.vectorNode && activeVectorShape != null && selectedNodeIndex != null) {
                      activeVectorShape!.nodes[selectedNodeIndex!].position += details.delta;
                    }
                  });
                },
                onTapDown: (details) {
                  if (currentTool == ToolType.vectorNode && activeVectorShape != null) {
                    for (int i = 0; i < activeVectorShape!.nodes.length; i++) {
                      if ((activeVectorShape!.nodes[i].position - details.localPosition).distance < 25) {
                        setState(() => selectedNodeIndex = i);
                        break;
                      }
                    }
                  }
                },
                child: CustomPaint(
                  painter: StudioAdvancedPainter(
                    layers: _currentLayers,
                    activeVectorShape: activeVectorShape,
                    selectedNodeIndex: selectedNodeIndex,
                    selectedBoneId: selectedBoneId,
                  ),
                  size: Size.infinite,
                ),
              ),
            ),
          ),
        ],
      ),

      // Таймлайн внизу
      bottomNavigationBar: Container(
        height: 85,
        color: const Color(0xFF222222),
        child: ListView.builder(
          scrollDirection: Axis.horizontal,
          itemCount: totalFrames,
          itemBuilder: (context, index) {
            int frameNum = index + 1;
            bool isSelected = frameNum == currentFrame;

            return GestureDetector(
              onTap: () => setState(() => currentFrame = frameNum),
              child: Container(
                width: 55,
                margin: const EdgeInsets.symmetric(horizontal: 4, vertical: 8),
                decoration: BoxDecoration(
                  color: isSelected ? Colors.blueAccent : const Color(0xFF2C2C2C),
                  borderRadius: BorderRadius.circular(6),
                ),
                child: Center(
                  child: Text('$frameNum', style: TextStyle(fontWeight: FontWeight.bold, color: isSelected ? Colors.white : Colors.grey)),
                ),
              ),
            );
          },
        ),
      ),
    );
  }

  Widget _toolButton(ToolType type, IconData icon, String label) {
    bool isSelected = currentTool == type;
    return InkWell(
      onTap: () => setState(() => currentTool = type),
      child: Container(
        padding: const EdgeInsets.all(8),
        decoration: BoxDecoration(
          color: isSelected ? Colors.blueAccent : Colors.grey[850],
          borderRadius: BorderRadius.circular(8),
        ),
        child: Column(
          children: [
            Icon(icon, size: 20, color: Colors.white),
            const SizedBox(height: 4),
            Text(label, style: const TextStyle(fontSize: 10)),
          ],
        ),
      ),
    );
  }
}

// ==================== Отрисовщик векторов и костей ====================

class StudioAdvancedPainter extends CustomPainter {
  final List<AnimLayer> layers;
  final VectorPathShape? activeVectorShape;
  final int? selectedNodeIndex;
  final String? selectedBoneId;

  StudioAdvancedPainter({
    required this.layers,
    this.activeVectorShape,
    this.selectedNodeIndex,
    this.selectedBoneId,
  });

  @override
  void paint(Canvas canvas, Size size) {
    final Paint vectorPaint = Paint()
      ..color = Colors.cyanAccent
      ..style = PaintingStyle.stroke
      ..strokeWidth = 4.0;

    final Paint nodePaint = Paint()
      ..color = Colors.amber
      ..style = PaintingStyle.fill;

    for (var layer in layers) {
      if (!layer.isVisible) continue;

      for (var shape in layer.vectorShapes) {
        if (shape.nodes.length > 1) {
          Path path = Path();
          path.moveTo(shape.nodes.first.position.dx, shape.nodes.first.position.dy);
          for (int i = 1; i < shape.nodes.length; i++) {
            path.lineTo(shape.nodes[i].position.dx, shape.nodes[i].position.dy);
          }
          canvas.drawPath(path, vectorPaint);
        }

        for (int i = 0; i < shape.nodes.length; i++) {
          nodePaint.color = (shape == activeVectorShape && i == selectedNodeIndex) ? Colors.redAccent : Colors.amber;
          canvas.drawCircle(shape.nodes[i].position, 6, nodePaint);
        }
      }

      final Paint bonePaint = Paint()
        ..color = Colors.orangeAccent
        ..strokeWidth = 5.0
        ..strokeCap = StrokeCap.round;

      Map<String, Offset> globalPositions = {};
      for (var bone in layer.bones.where((b) => b.parentId == null)) {
        globalPositions[bone.id] = bone.localPosition;
        _drawBones(canvas, bone, layer.bones, globalPositions, bonePaint);
      }
    }
  }

  void _drawBones(Canvas canvas, Bone currentBone, List<Bone> allBones, Map<String, Offset> globalPositions, Paint bonePaint) {
    Offset start = globalPositions[currentBone.id]!;
    Offset end = start + Offset(math.cos(currentBone.rotation) * currentBone.length, math.sin(currentBone.rotation) * currentBone.length);
    globalPositions[currentBone.id + '_end'] = end;

    bonePaint.color = currentBone.id == selectedBoneId ? Colors.greenAccent : Colors.orangeAccent;
    canvas.drawLine(start, end, bonePaint);
    canvas.drawCircle(start, 6, Paint()..color = Colors.white);

    for (var child in allBones.where((b) => b.parentId == currentBone.id)) {
      globalPositions[child.id] = end + child.localPosition;
      _drawBones(canvas, child, allBones, globalPositions, bonePaint);
    }
  }

  @override
  bool shouldRepaint(covariant StudioAdvancedPainter oldDelegate) => true;
}
